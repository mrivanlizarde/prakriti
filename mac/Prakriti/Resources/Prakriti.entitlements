<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- No App Sandbox, on purpose: Prakriti runs ffmpeg and Parakeet as subprocesses and reads
     Ivan's recording folders directly. Hardened runtime is on (project.yml). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
